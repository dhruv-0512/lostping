│   │   ├── loiter.py
│   │   ├── zscore.py
│   │   └── scorer.py
│   └── report/
│       ├── map.py
│       ├── json_report.py
│       └── html_report.py
├── data/
│   ├── raw/            ← drop CSVs here
│   ├── processed/
│   └── boundaries/     ← EEZ / STS GeoJSON
├── outputs/
